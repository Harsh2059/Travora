# ==============================================================================
# Travora - Root .gitignore
# ==============================================================================

# --- Python & Virtual Environments ---
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/
*.venv

# --- Python Bytecode & Cache ---
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node.js & Frontend Build Outputs ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Flutter & Mobile Build Artifacts ---
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
sms_gateway/build/
sms_gateway/.dart_tool/
sms_gateway/.flutter-plugins
sms_gateway/.flutter-plugins-dependencies
sms_gateway/android/.gradle/
sms_gateway/android/build/
sms_gateway/android/local.properties
sms_gateway/android/*.hprof

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# --- Local Databases & Test Artifacts ---
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/test_*.db
travel_engine.db
backend/travel_engine.db

# --- Scratch one-off debug scripts (keep real tests) ---
scratch/debug_*.py
scratch/trace_*.py
scratch/verify_*.py
scratch/inspect_*.py

# --- OS & IDE Metadata ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/
agent-transcripts/
