# ==============================================================================
# Travora - Root .gitignore
# ==============================================================================

# --- Python & Virtual Environments ---
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/
*.venv

# --- Python Bytecode & Cache ---
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node.js & Frontend Build Outputs ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# --- Local Databases & Test Artifacts ---
*.db-journal
backend/test_*.db

# --- OS & IDE Metadata ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
