# ============================================================
# Travora Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit it.
#
# LOCAL DEV (Option A): Use live Supabase DB on Render
#   → Just fill DATABASE_URL with the Supabase connection string
#   → No local Postgres needed
#
# LOCAL DEV (Option B): Use a local SQLite DB (zero setup)
#   → Leave DATABASE_URL blank — backend falls back to SQLite
#   → Good for offline development
#
# PRODUCTION (Render): Set all vars in Render dashboard
#   → Environment Variables tab in your Render service settings
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Option A: Supabase PostgreSQL (shared with production)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Option B: Local SQLite (leave DATABASE_URL blank or remove it)
# DATABASE_URL=

# ── Authentication ───────────────────────────────────────────
# IMPORTANT: Use the SAME secret locally as on Render,
# otherwise tokens issued locally won't be accepted by Render and vice versa.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── WhatsApp API ─────────────────────────────────────────────
WHATSAPP_MODE=sandbox
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
DEMO_WHATSAPP_NUMBER=+917710989533

# ── SMS ──────────────────────────────────────────────────────
DEMO_SMS_RECIPIENT=+917710989533